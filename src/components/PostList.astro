---
import { categoryInfo, categories } from '../data/categories';
import { formatDate, type Post } from '../lib/blog';

interface Props {
  posts: Post[];
  active?: string;
  allPosts: Post[];
}

const { posts, active, allPosts } = Astro.props;

// Only categories that have at least one published post get a tab.
const slugs = [...new Set(allPosts.map((p) => p.category))].sort(
  (a, b) => Object.keys(categories).indexOf(a) - Object.keys(categories).indexOf(b),
);
const count = (slug: string) => allPosts.filter((p) => p.category === slug).length;
---

<nav class="cat-nav" aria-label="Blog categories">
  <a href="/blog/" aria-current={!active ? 'page' : undefined}>All <span>{allPosts.length}</span></a>
  {slugs.map((s) => (
    <a href={`/blog/category/${s}/`} aria-current={active === s ? 'page' : undefined}>
      {categoryInfo(s).title} <span>{count(s)}</span>
    </a>
  ))}
</nav>

{posts.length === 0 ? (
  <p class="muted">No posts yet.</p>
) : (
  <ul class="posts">
    {posts.map((post) => (
      <li>
        <a href={`/blog/${post.id}/`}>
          <span class="meta">
            {formatDate(post.data.date)} · {categoryInfo(post.category).title} · {post.minutes} min read
          </span>
          <span class="t">{post.data.title}</span>
          <span class="d">{post.data.description}</span>
        </a>
      </li>
    ))}
  </ul>
)}
