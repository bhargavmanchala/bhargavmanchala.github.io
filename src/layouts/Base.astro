---
import '@fontsource-variable/inter/wght.css';
import '../styles/site.css';
import Icon from '../components/Icon.astro';
import { blogEnabled } from '../data/site.js';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const siteName = 'Bhargav Manchala';
const {
  title,
  description = 'Bhargav Manchala, a problem solver and AI engineer (Senior Innovation Engineer - Agentic AI), builds voice agents and AI platforms and figures out solutions to hard problems.',
  noindex = false,
} = Astro.props;
const pageTitle = title ? `${title} | ${siteName}` : `${siteName} | Senior Innovation Engineer - Agentic AI`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const current = (p: string) => ((p === '/' ? path === '/' : path.startsWith(p)) ? 'page' : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#000000" />
    {blogEnabled && <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="/">Bhargav Manchala</a>
        <nav class="nav" aria-label="Main">
          <a class="link hide-sm" href="/website/" aria-current={current('/website')}>Work</a>
          <a class="link hide-sm" href="/resume/" aria-current={current('/resume')}>Résumé</a>
          {blogEnabled ? (
            <a class="link keep" href="/blog/" aria-current={current('/blog')}>Blog</a>
          ) : (
            <span class="link keep disabled" aria-disabled="true" title="The blog is coming soon">
              Blog <span class="soon">Soon</span>
            </span>
          )}
          <div class="nav-tools">
            <a class="btn btn-primary btn-sm" href="/website/#contact">Contact</a>
            <button class="btn btn-sm theme-toggle" id="theme-toggle" type="button" aria-label="Switch colour theme">
              <span class="i-sun"><Icon name="sun" /></span>
              <span class="i-moon"><Icon name="moon" /></span>
            </button>
          </div>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <span>© {new Date().getFullYear()} Bhargav Manchala</span>
        <span class="visits" id="visits" hidden>
          <Icon name="eye" /> <span id="visit-count"></span> visits
        </span>
        <nav aria-label="Elsewhere">
          <a href="https://www.linkedin.com/in/bhargavmanchala/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href="https://github.com/bhargavmanchala" target="_blank" rel="noopener noreferrer">GitHub</a>
        </nav>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', function () {
        var next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
      });

      // Visit counter: one visit per browser per 24 hours, counted only on the real site (not on localhost).
      (function () {
        var box = document.getElementById('visits');
        if (!box) return;
        var api = 'https://abacus.jasoncameron.dev/';
        var path = 'bhargavmanchala.github.io/visits';
        var isLive = location.hostname === 'bhargavmanchala.github.io';
        var recent = false;
        try {
          var last = Number(localStorage.getItem('visit-ts') || 0);
          recent = Date.now() - last < 24 * 60 * 60 * 1000;
        } catch (e) {}
        var action = isLive && !recent ? 'hit' : 'get';
        fetch(api + action + '/' + path)
          .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
          .then(function (d) {
            if (typeof d.value !== 'number') return;
            document.getElementById('visit-count').textContent = d.value.toLocaleString('en-US');
            box.hidden = false;
            if (action === 'hit') { try { localStorage.setItem('visit-ts', String(Date.now())); } catch (e) {} }
          })
          .catch(function () {});
      })();
    </script>
  </body>
</html>
